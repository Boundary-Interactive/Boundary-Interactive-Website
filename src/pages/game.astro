---
import Layout from "../layouts/Layout.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import { game, links, studio } from "../data/site";
import { images } from "../data/images";
import { ogImages, pageSeo } from "../data/seo";
import { getCollection } from "astro:content";
import { buildVideoGameSchema } from "../utils/jsonLd";
import { withBase } from "../utils/withBase";

const posts = (await getCollection("devlogs")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const [latestDevlog] = posts;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout
  title={pageSeo.game.title}
  description={pageSeo.game.description}
  ogImage={ogImages.game.path}
  jsonLd={buildVideoGameSchema(Astro.site, canonicalURL)}
>
  <section class="hero">
    <p class="status">{game.statusBadge} • {game.platform} • {game.priceLabel}</p>
    <p class="muted release-target">{game.releaseTarget}</p>
    <h1>{game.title}</h1>
    <p>{game.pitch}</p>
    <p class="muted">{game.shortDescription}</p>
    <p class="muted">Genres: {game.genres.join(" / ")} • Rating: {game.rating} • Price: {game.priceLabel}</p>
    <figure class="media-block">
      <div class="video-embed">
        <iframe
          src={game.trailerEmbedUrl}
          title="Fly Exterminator Official Trailer"
          loading="eager"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
      <figcaption class="media-caption">
        Official trailer — mixed-reality fly catching on Meta Quest 3.
      </figcaption>
    </figure>
    <div class="btn-row">
      <a class="button" href={game.storeUrl}>{game.storeCta}</a>
      <a class="button secondary" href={withBase("/press")}>Fly Exterminator press kit</a>
    </div>
  </section>

  <section class="panel">
    <h2>About the game</h2>
    {game.about.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </section>

  <section class="panel">
    <h2>How it plays</h2>
    <ol class="game-steps">
      {game.howItPlays.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Feature highlights</h2>
    <ul>
      {game.highlights.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <figure class="media-block">
      <OptimizedImage
        class="showcase-image"
        src={images.heroArt.src}
        alt="Fly Exterminator key art showing a player swatting a fly in a living room."
        width={images.heroArt.width}
        height={images.heroArt.height}
      />
      <figcaption class="media-caption">
        Key art — hand-tracked swatting in a real living room playspace.
      </figcaption>
    </figure>
    <figure class="media-block">
      <OptimizedImage
        src={images.roomScanning.src}
        alt="Meta Quest 3 room scanning overlay used for Fly Exterminator mixed-reality development."
        class="showcase-image"
        width={images.roomScanning.width}
        height={images.roomScanning.height}
      />
      <figcaption class="media-caption">
        Quest 3 room scanning so flies travel along your real walls, floors, and furniture.
      </figcaption>
    </figure>
    <figure class="media-block">
      <OptimizedImage
        src={images.gameUi.src}
        alt="Fly Exterminator in-game mixed-reality menu UI showing time trial options and scoring instructions."
        class="showcase-image"
        width={images.gameUi.width}
        height={images.gameUi.height}
      />
      <figcaption class="media-caption">
        In-headset menus for mode setup and scoring, built to stay readable in mixed reality.
      </figcaption>
    </figure>
  </section>

  <section class="panel">
    <h2>Player FAQ</h2>
    <p>
      <strong>Where can I get it?</strong>
      Out now in Early Access on the <a href={game.storeUrl}>Meta Store</a> for {game.priceLabel}
      (Meta Quest 3 only).
    </p>
    <p><strong>Platform:</strong> {game.platform} only (mixed reality; room setup and scene capture required).</p>
    <p>
      <strong>Controls:</strong> Hand tracking for swatting flies; in-headset UI for menus and mode setup.
    </p>
    <p>
      <strong>Modes:</strong> Arcade score chasing in the Early Access build—Time Attack, Time Survival, and Food
      Defense, plus tutorials for the core loop.
    </p>
    <p>
      <strong>Who is making it?</strong>
      <a href={withBase("/about")}>{studio.legalName}</a> ({studio.name}), a two-person studio founded
      by Matthew Tran and Chaeho Shin. The team showcased the game at USC Games Expo 2026 and released
      Early Access on July 31, 2026.
    </p>
    <p>
      <strong>How do I send feedback?</strong>
      We welcome player feedback. Join the <a href={links.discord}>Discord community</a>, email
      <a href={`mailto:${game.contactEmail}`}>{game.contactEmail}</a>, or read the
      <a href={withBase("/devlog")}>devlog</a>.
    </p>
    <p>
      <strong>Where can I follow updates?</strong>
      Get it on the <a href={game.storeUrl}>Meta Store listing</a>, join Discord, browse the
      <a href={withBase("/press")}>press kit</a>, or follow the
      <a href={withBase("/devlog")}>devlog</a>.
    </p>
  </section>

  {latestDevlog && (
    <section class="panel">
      <h2>Latest devlog</h2>
      <p>
        <a href={withBase(`/devlog/${latestDevlog.id}/`)}>{latestDevlog.data.title}</a>
        — {latestDevlog.data.summary}
      </p>
      <p><a href={withBase("/devlog")}>View all Fly Exterminator devlog posts</a></p>
    </section>
  )}

  <section class="panel">
    <h2>Development timeline</h2>
    <p>{game.developmentTimeline}</p>
  </section>
</Layout>
